{
  "manifest_version": 3,
  "name": "AI Image Detector",
  "version": "1.0.0",
  "description": "Detect if an image is real or AI-generated using Deep Learning.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Image Detector"
  },
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ]
}
